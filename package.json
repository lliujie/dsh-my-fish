{
  "name": "@local/dafeiyu",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "description": "大肥鱼：模块化的本地工作台。项目（文件树 / 就地编辑 / 文档内嵌预览 / 面板内和主智能体对话）+ 站点台账（环境分组与状态灯）+ 版本中心（变更日志、快照与一键回滚）。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./version.json": "./version.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "version.json",
    "locale",
    "docs",
    "README.md",
    "gitlog.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
