{
  "name": "@local/dafeiyu",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "description": "大肥鱼 3.0：场景化工作台。一个场景 = 一套网格面板 + 一条常驻 AI 会话 + 定位卡与场景记忆；面板类型有 AI / 文件 / 预览 / 网页 / 记忆 / 预留。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./version.json": "./version.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "version.json",
    "locale",
    "scenarios",
    "docs",
    "README.md",
    "gitlog.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
